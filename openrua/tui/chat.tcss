Screen { background: $surface; }
#status { height: 3; padding: 1 2; background: $primary-background; text-style: bold; }
#body { height: 1fr; }
#thread { width: 1fr; height: 1fr; padding: 0 2; }
#panel { width: 34; padding: 1; border-left: solid $primary; }
#queue, .queue-entry, .turn, .outputs { height: auto; }
.turn { margin: 1 0; }
.turn-status { color: $text-muted; }
.user-text { padding: 1; background: $boost; }
.agent-output { padding: 1 0; }
.result { color: $text-muted; }
.queue-entry { margin-bottom: 1; }
.buttons { height: auto; min-height: 3; }
Button { min-width: 10; margin-right: 1; }
#actions { padding: 0 1; }
#message { height: 5; margin: 0 1; border: round $primary; }
#notice { height: auto; max-height: 3; padding: 0 1; color: $warning; }
#hint { width: 1fr; padding-top: 1; color: $text-muted; }
ModalScreen { align: center middle; background: $background 70%; }
.dialog { width: 72; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; border: round $primary; background: $surface; }
.dialog TextArea { height: 8; margin: 1 0; }
.dialog Input, .dialog Select { margin: 1 0; }
.narrow #body { layout: vertical; }
.narrow #panel { width: 100%; height: 40%; max-height: 8; border-left: none; border-top: solid $primary; }
.narrow #actions { overflow-x: auto; }
.narrow #hint { display: none; }

.narrow #status { height: 2; padding: 0 1; }
.narrow #message { height: 4; }
